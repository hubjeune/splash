14336  5120  24   decode none     ggufstaged   224    2          1   # qkv +9%
14336  5120  32   decode none     ggufstaged   224    2          1   # qkv +9%
5120   6144  8    decode residual ggufregister 80     4          2   # gdn_out +4%
5120   17408 8    decode residual ggufregister 80     4          2   # down +2%
